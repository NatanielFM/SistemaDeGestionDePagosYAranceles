<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="pagosPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.ipesmi.pagos.model.Estudiante</class>
        <class>com.ipesmi.pagos.model.Concepto</class>
        <class>com.ipesmi.pagos.model.Pago</class>
        <class>com.ipesmi.pagos.model.PagoEfectivo</class>
        <class>com.ipesmi.pagos.model.PagoTarjeta</class>
        <class>com.ipesmi.pagos.model.PagoTransferencia</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Valores por defecto: se pueden sobrescribir en config/db.properties -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/pagos_aranceles?createDatabaseIfNotExist=true&amp;serverTimezone=America/Argentina/Buenos_Aires&amp;characterEncoding=UTF-8"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Crea/actualiza las tablas si no existen (el script SQL también las crea) -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
