<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ipesmi.pagos.controller.PagosController" spacing="22">

    <VBox spacing="16" HBox.hgrow="ALWAYS">
        <VBox spacing="2">
            <Label text="Pagos" styleClass="titulo"/>
            <Label text="Registro, acreditación y anulación de pagos de matrícula, cuotas y exámenes."
                   styleClass="subtitulo"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscar" promptText="Buscar por estudiante, concepto o referencia"
                       styleClass="campo-busqueda" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="cmbFiltroEstado" prefWidth="170"/>
            <ComboBox fx:id="cmbFiltroMedio" prefWidth="170"/>
        </HBox>

        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="#" prefWidth="42" minWidth="42"/>
                <TableColumn fx:id="colFecha" text="FECHA" prefWidth="94" minWidth="94"/>
                <TableColumn fx:id="colEstudiante" text="ESTUDIANTE" prefWidth="150" minWidth="110"/>
                <TableColumn fx:id="colConcepto" text="CONCEPTO" prefWidth="130" minWidth="95"/>
                <TableColumn fx:id="colMedio" text="MEDIO" prefWidth="180" minWidth="125"/>
                <TableColumn fx:id="colMonto" text="MONTO" prefWidth="118" minWidth="118" styleClass="columna-monto"/>
                <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="110" minWidth="110"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
        </TableView>

        <HBox styleClass="barra-acciones">
            <Label fx:id="lblResumenTabla" styleClass="pie-tabla"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAcreditar" text="Acreditar" styleClass="btn-exito" onAction="#acreditar"/>
            <Button fx:id="btnEditar" text="Editar" styleClass="btn-secundario" onAction="#editar"/>
            <Button fx:id="btnAnular" text="Anular" styleClass="btn-peligro" onAction="#anular"/>
            <Button fx:id="btnEliminar" text="Eliminar" styleClass="btn-texto" onAction="#eliminar"/>
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" prefWidth="318" minWidth="318" hbarPolicy="NEVER">
        <VBox fx:id="formulario" styleClass="panel, formulario">
            <Label fx:id="lblFormTitulo" text="Nuevo pago" styleClass="form-titulo"/>

            <VBox spacing="5">
                <Label text="ESTUDIANTE" styleClass="etiqueta-campo"/>
                <ComboBox fx:id="cmbEstudiante" maxWidth="Infinity" promptText="Seleccione un estudiante"/>
            </VBox>
            <VBox spacing="5">
                <Label text="CONCEPTO" styleClass="etiqueta-campo"/>
                <ComboBox fx:id="cmbConcepto" maxWidth="Infinity" promptText="Seleccione un concepto"/>
            </VBox>

            <Label fx:id="lblImporte" styleClass="info-importe" wrapText="true" maxWidth="Infinity"
                   text="Elija estudiante y concepto para ver el saldo."/>

            <VBox spacing="5">
                <Label text="MEDIO DE PAGO" styleClass="etiqueta-campo"/>
                <HBox fx:id="boxMedio" styleClass="segmentado">
                    <fx:define><ToggleGroup fx:id="grupoMedio"/></fx:define>
                    <ToggleButton fx:id="tbEfectivo" text="Efectivo" toggleGroup="$grupoMedio" selected="true"
                                  styleClass="primero, efectivo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="tbTarjeta" text="Tarjeta" toggleGroup="$grupoMedio"
                                  styleClass="tarjeta" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <ToggleButton fx:id="tbTransferencia" text="Transferencia" toggleGroup="$grupoMedio"
                                  styleClass="ultimo, transferencia" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="120">
                    <Label text="MONTO" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtMonto" promptText="0,00"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="140">
                    <Label text="FECHA" styleClass="etiqueta-campo"/>
                    <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
                </VBox>
            </HBox>
            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblReferencia" text="NRO. DE RECIBO (OPCIONAL)" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtReferencia"/>
                </VBox>
                <VBox fx:id="boxCuotas" spacing="5" prefWidth="86" minWidth="86">
                    <Label text="CUOTAS" styleClass="etiqueta-campo"/>
                    <Spinner fx:id="spCuotas" maxWidth="Infinity" editable="true"/>
                </VBox>
            </HBox>
            <VBox fx:id="boxBanco" spacing="5">
                <Label text="BANCO DE ORIGEN" styleClass="etiqueta-campo"/>
                <TextField fx:id="txtBanco" promptText="Ej.: Banco Nación"/>
            </VBox>

            <HBox spacing="8">
                <Button fx:id="btnRegistrar" text="Registrar pago" styleClass="btn-primario" maxWidth="Infinity"
                        HBox.hgrow="ALWAYS" onAction="#guardar" defaultButton="true"/>
                <Button fx:id="btnLimpiar" text="Limpiar" styleClass="btn-secundario" onAction="#limpiar"/>
            </HBox>
        </VBox>
    </ScrollPane>
</HBox>
